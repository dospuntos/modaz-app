","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"124","messages":"125","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"126","messages":"127","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"128","messages":"129","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"130","messages":"131","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"132","messages":"133","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"134","messages":"135","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"136","messages":"137","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"138","messages":"139","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"140","messages":"141","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"142","messages":"143","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"144","messages":"145","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"146","messages":"147","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"148","messages":"149","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"150","messages":"151","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"152","messages":"153","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"154","messages":"155","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"156","messages":"157","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"158","messages":"159","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"160","messages":"161","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"162","messages":"163","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"164","messages":"165","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"166","messages":"167","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"168","messages":"169","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"170","messages":"171","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"172","messages":"173","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"174","messages":"175","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"176","messages":"177","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"178","messages":"179","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"180","messages":"181","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"182","messages":"183","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"184","messages":"185","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},{"filePath":"186","messages":"187","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"96"},"C:\\wamp\\www\\modaz-app\\src\\index.js",[],["188","189"],"C:\\wamp\\www\\modaz-app\\src\\serviceWorker.js",[],"C:\\wamp\\www\\modaz-app\\src\\App.jsx",[],"C:\\wamp\\www\\modaz-app\\src\\hooks.js",[],"C:\\wamp\\www\\modaz-app\\src\\cartReducer.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\Orders.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\Products.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\ProductEdit.js",["190"],"import { useEffect, useState } from \"react\";\nimport { useParams } from \"react-router-dom\";\nimport {\n  getProductById,\n  getVariantsById,\n  saveVariant,\n  saveProduct,\n  deleteVariant,\n  getCategories,\n} from \"api/productApi\";\nimport { RiArrowLeftSLine } from \"react-icons/ri\";\nimport TextInput from \"modules/form/TextInput\";\nimport ProductVariant from \"modules/products/ProductVariant\";\nimport Categories from \"modules/products/Categories\";\nimport { makeStyles } from \"@material-ui/core/styles\";\nimport Grid from \"@material-ui/core/Grid\";\nimport Modal from \"@material-ui/core/Modal\";\nimport TextField from \"@material-ui/core/TextField\";\nimport Button from \"@material-ui/core/Button\";\nimport EditIcon from \"@material-ui/icons/Edit\";\nimport SaveIcon from \"@material-ui/icons/Save\";\nimport ImageEdit from \"components/ImageEdit\";\nimport { getDefaultImage, getAllImages } from \"functions\";\nimport AddCircleOutlineIcon from \"@material-ui/icons/AddCircleOutline\";\nimport InputAdornment from \"@material-ui/core/InputAdornment\";\nimport IconButton from \"@material-ui/core/IconButton\";\n\nconst useStyles = makeStyles((theme) => ({\n  root: {\n    flexGrow: 1,\n  },\n  paper: {\n    top: \"50%\",\n    left: \"50%\",\n    transform: \"translate(-50%, -50%)\",\n    position: \"absolute\",\n    width: \"60%\",\n    maxHeight: \"90%\",\n    overflow: \"auto\",\n    backgroundColor: theme.palette.background.paper,\n    border: \"2px solid #000\",\n    boxShadow: theme.shadows[5],\n    padding: theme.spacing(2, 4, 3),\n  },\n}));\n\nexport default function ProductEdit(props) {\n  const [product, setProduct] = useState([\n    {\n      id: \"\",\n      name: \"\",\n      images: \"{}\",\n      orderdate: \"\",\n      release_date: \"\",\n      category: \"\",\n      season: \"\",\n      wholesaleprice: \"\",\n      msrp: \"\",\n      price: \"\",\n      zinprice: \"\",\n      weight: \"\",\n      composition: \"\",\n      manufacturer: \"\",\n      coo: \"\",\n      country: \"\",\n    },\n  ]);\n\n  const [edited, setEdited] = useState(false);\n  const [variants, setVariants] = useState([]);\n  const [categories, setCategories] = useState([]);\n  const [open, setOpen] = useState(false);\n\n  const classes = useStyles();\n\n  let { productid } = useParams();\n  if (!productid) {\n    productid = props.id;\n  }\n\n  useEffect(() => {\n    // Get products and split category list to array\n    getProductById(productid).then((product) => {\n      setProduct({ ...product, category: product.category.split(\",\") });\n    });\n\n    // Get variants\n    getVariantsById(productid).then((variants) => {\n      setVariants(variants);\n    });\n\n    // Get categories\n    getCategories().then((categories) => {\n      setCategories(categories);\n    });\n  }, [productid]);\n\n  function handleChange({ target }) {\n    const updatedProduct = {\n      ...product,\n      [target.name]: target.value,\n    };\n    setProduct(updatedProduct);\n    setEdited(true);\n  }\n\n  function handleVariantChange(e, id, field) {\n    const updatedVariants = variants.map((variant) =>\n      variant.id === id ? { ...variant, [field]: e.target.value } : variant\n    );\n    setVariants(updatedVariants);\n  }\n\n  function handleVariantSave(id) {\n    const variant = variants.filter((variant) => {\n      return variant.id === id;\n    });\n    saveVariant(variant);\n  }\n\n  function handleProductSave() {\n    let _product = product;\n    saveProduct({\n      ...product,\n      category: _product.category.join(\",\"),\n    }).then(setEdited(false));\n  }\n\n  function addVariant(e) {\n    e.preventDefault();\n    const newVariant = [\n      {\n        id: \"0\",\n        product_id: product.id,\n        upc: \"0\",\n        item_code: \"0\",\n        color: \"-\",\n        size: \"-\",\n        stock: \"0\",\n      },\n    ];\n    saveVariant({ ...newVariant }).then(() => {\n      getVariantsById(productid).then((variants) => {\n        setVariants(variants);\n      });\n    });\n  }\n\n  function handleVariantDelete(e, id) {\n    e.preventDefault();\n    if (window.confirm(\"¿Quieres eliminar este modelo?\")) {\n      deleteVariant(id);\n      let _variants = variants.filter((v) => v.id !== id);\n      setVariants(_variants);\n    }\n  }\n\n  function handleCategoryChange(value) {\n    setProduct({ ...product, category: value });\n    setEdited(true);\n  }\n\n  function handleClose() {\n    setOpen(false);\n  }\n\n  function handleImageChange(type, index, value) {\n    let images = getAllImages(product.images);\n    images[index][type] = value;\n    setProduct({ ...product, images: JSON.stringify(images) });\n    setEdited(true);\n  }\n\n  function handleMakeDefaultImage(index) {\n    let images = getAllImages(product.images);\n    images.forEach(function (item, i) {\n      if (i === index) {\n        images.splice(i, 1);\n        images.unshift(item);\n      }\n    });\n\n    setProduct({ ...product, images: JSON.stringify(images) });\n    setEdited(true);\n  }\n\n  function handleAddImage() {\n    let images = [\n      ...getAllImages(product.images),\n      { image: \"default.png\", color: \"bold black\" },\n    ];\n    setProduct({ ...product, images: JSON.stringify(images) });\n    setEdited(true);\n  }\n\n  function handleDeleteImage(index) {\n    let images = getAllImages(product.images);\n    images.splice(index, 1);\n    setProduct({ ...product, images: JSON.stringify(images) });\n    setEdited(true);\n  }\n\n  return (\n    <div className={classes.root}>\n      <Modal open={open} onClose={handleClose}>\n        <div className={classes.paper}>\n          <ImageEdit\n            images={product.images}\n            handleImageChange={handleImageChange}\n            handleMakeDefaultImage={handleMakeDefaultImage}\n            handleAddImage={handleAddImage}\n            handleDeleteImage={handleDeleteImage}\n          />\n        </div>\n      </Modal>\n      <Grid container spacing={3}>\n        <Grid item xs={12} md={8}>\n          <h1>{product.name}</h1>\n        </Grid>\n        <Grid item xs={12} md={4}>\n          <p>\n            {!props.id && (\n              <Button\n                variant=\"contained\"\n                color=\"secondary\"\n                onClick={() =>\n                  !edited || window.confirm(\"¿Volver sin guardar?\")\n                    ? props.history.goBack()\n                    : null\n                }\n              >\n                <RiArrowLeftSLine /> Volver\n              </Button>\n            )}\n            &nbsp;\n            <Button\n              onClick={handleProductSave}\n              disabled={!edited}\n              variant=\"contained\"\n              color=\"primary\"\n              startIcon={<SaveIcon />}\n            >\n              Guardar\n            </Button>\n          </p>\n        </Grid>\n      </Grid>\n      <Grid container spacing={3}>\n        <Grid item xs={12} md={8}>\n          <Grid container spacing={3}>\n            <Grid item xs={12}>\n              <TextField\n                name=\"name\"\n                value={product.name || \"\"}\n                onChange={handleChange}\n                label=\"Nombre\"\n                variant=\"filled\"\n                fullWidth\n              />\n            </Grid>\n            <Grid item xs={12} sm={6} md={4}>\n              <TextField\n                label=\"Precio ModaZ\"\n                onChange={handleChange}\n                name=\"price\"\n                value={product.price || \"\"}\n                size=\"small\"\n                variant=\"outlined\"\n                InputProps={{\n                  startAdornment: (\n                    <InputAdornment position=\"start\">Bs</InputAdornment>\n                  ),\n                }}\n              />\n            </Grid>\n            <Grid item xs={12} sm={6} md={4}>\n              <TextField\n                label=\"Descuento\"\n                onChange={handleChange}\n                name=\"price_discount\"\n                value={product.price_discount || \"\"}\n                size=\"small\"\n                variant=\"outlined\"\n                InputProps={{\n                  startAdornment: (\n                    <InputAdornment position=\"start\">Bs</InputAdornment>\n                  ),\n                }}\n              />\n            </Grid>\n            <Grid item xs={12} sm={6} md={4}>\n              <TextField\n                label=\"Precio ZIN\"\n                onChange={handleChange}\n                name=\"zinprice\"\n                value={product.zinprice || \"\"}\n                size=\"small\"\n                variant=\"outlined\"\n                InputProps={{\n                  startAdornment: (\n                    <InputAdornment position=\"start\">Bs</InputAdornment>\n                  ),\n                }}\n              />\n            </Grid>\n            <Grid item xs={12} sm={6} md={4} lg={6}>\n              <TextField\n                label=\"Precio revendedora\"\n                onChange={handleChange}\n                name=\"wholesaleprice\"\n                value={product.wholesaleprice || \"\"}\n                size=\"small\"\n                variant=\"outlined\"\n                InputProps={{\n                  startAdornment: (\n                    <InputAdornment position=\"start\">$US</InputAdornment>\n                  ),\n                }}\n              />\n            </Grid>\n            <Grid item xs={12} sm={6} md={4} lg={6}>\n              <TextField\n                label=\"MSRP\"\n                onChange={handleChange}\n                name=\"msrp\"\n                value={product.msrp || \"\"}\n                size=\"small\"\n                variant=\"outlined\"\n                InputProps={{\n                  startAdornment: (\n                    <InputAdornment position=\"start\">$US</InputAdornment>\n                  ),\n                }}\n              />\n            </Grid>\n          </Grid>\n          <hr />\n          <h2>Modelos</h2>\n          <p>\n            <small>(Los cambios se guardan inmediatamente)</small>\n          </p>\n          {variants.map((item) => {\n            return (\n              <ProductVariant\n                key={item.id}\n                item={item}\n                handleVariantChange={handleVariantChange}\n                handleVariantSave={handleVariantSave}\n                handleVariantDelete={handleVariantDelete}\n              />\n            );\n          })}\n          <Button\n            variant=\"contained\"\n            onClick={addVariant}\n            startIcon={<AddCircleOutlineIcon />}\n            size=\"small\"\n          >\n            Agregar modelo\n          </Button>\n        </Grid>\n        <Grid item xs={12} md={4}>\n          <Categories\n            categories={categories}\n            prodCats={product.category || []}\n            handleChange={handleCategoryChange}\n          />\n          <img src={getDefaultImage(product.images)} alt={product.name} />\n          <br />\n          {getAllImages(product.images).map((item, index) => {\n            return (\n              index > 0 && (\n                <img\n                  className=\"thumbnail zoom\"\n                  style={{ display: \"inline-block\", maxWidth: 50 }}\n                  src={process.env.REACT_APP_PROD_IMG_URL + item.image}\n                  alt={item.color}\n                  onClick={() => handleMakeDefaultImage(index)}\n                />\n              )\n            );\n          })}\n          <Button\n            fullWidth\n            variant=\"contained\"\n            startIcon={<EditIcon />}\n            onClick={() => setOpen(true)}\n          >\n            Editar\n          </Button>\n          <TextInput\n            label=\"Order Date\"\n            onChange={handleChange}\n            name=\"orderdate\"\n            value={product.orderdate || \"\"}\n          />\n          <TextInput\n            label=\"Release Date\"\n            onChange={handleChange}\n            name=\"release_date\"\n            value={product.release_date || \"\"}\n          />\n          <TextInput\n            label=\"Season\"\n            onChange={handleChange}\n            name=\"season\"\n            value={product.season || \"\"}\n          />\n          <TextInput\n            label=\"Weight\"\n            onChange={handleChange}\n            name=\"weight\"\n            value={product.weight || \"\"}\n          />\n          <TextInput\n            label=\"Composition\"\n            onChange={handleChange}\n            name=\"composition\"\n            value={product.composition || \"\"}\n          />\n          <TextInput\n            label=\"Manufacturer\"\n            onChange={handleChange}\n            name=\"manufacturer\"\n            value={product.manufacturer || \"\"}\n          />\n          <TextInput\n            label=\"COO\"\n            onChange={handleChange}\n            name=\"coo\"\n            value={product.coo || \"\"}\n          />\n          <TextInput\n            label=\"Country\"\n            onChange={handleChange}\n            name=\"country\"\n            value={product.country || \"\"}\n          />\n        </Grid>\n      </Grid>\n    </div>\n  );\n}\n","C:\\wamp\\www\\modaz-app\\src\\modules\\ScrollToTop.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\OrderDetails.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\Users.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\SidebarMenu.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\Stock.js",[],"C:\\wamp\\www\\modaz-app\\src\\components\\Dashboard.jsx",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\AddToCart.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Tools.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Consult.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Remove.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Add.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\MissingImages.js",[],"C:\\wamp\\www\\modaz-app\\src\\api\\productApi.js",[],"C:\\wamp\\www\\modaz-app\\src\\api\\orderApi.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\ShowPrices.jsx",[],"C:\\wamp\\www\\modaz-app\\src\\api\\apiUtils.js",[],"C:\\wamp\\www\\modaz-app\\src\\api\\statisticsApi.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\NewsList.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\TodoList.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\cart\\Cart.js",[],"C:\\wamp\\www\\modaz-app\\src\\api\\usersApi.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\OrderDetailsList.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\OrderDetailsQuote.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\AddOrderItem.js",[],"C:\\wamp\\www\\modaz-app\\src\\functions.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\products\\Categories.js",[],"C:\\wamp\\www\\modaz-app\\src\\modules\\products\\Produc