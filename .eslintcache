[{"C:\\wamp\\www\\modaz-app\\src\\index.js":"1","C:\\wamp\\www\\modaz-app\\src\\serviceWorker.js":"2","C:\\wamp\\www\\modaz-app\\src\\App.jsx":"3","C:\\wamp\\www\\modaz-app\\src\\hooks.js":"4","C:\\wamp\\www\\modaz-app\\src\\cartReducer.js":"5","C:\\wamp\\www\\modaz-app\\src\\components\\Orders.js":"6","C:\\wamp\\www\\modaz-app\\src\\components\\Products.js":"7","C:\\wamp\\www\\modaz-app\\src\\components\\ProductEdit.js":"8","C:\\wamp\\www\\modaz-app\\src\\modules\\ScrollToTop.js":"9","C:\\wamp\\www\\modaz-app\\src\\components\\OrderDetails.js":"10","C:\\wamp\\www\\modaz-app\\src\\components\\Users.js":"11","C:\\wamp\\www\\modaz-app\\src\\components\\SidebarMenu.js":"12","C:\\wamp\\www\\modaz-app\\src\\components\\Stock.js":"13","C:\\wamp\\www\\modaz-app\\src\\components\\Dashboard.jsx":"14","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\AddToCart.js":"15","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Tools.js":"16","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Consult.js":"17","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Remove.js":"18","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\Add.js":"19","C:\\wamp\\www\\modaz-app\\src\\modules\\stock\\MissingImages.js":"20","C:\\wamp\\www\\modaz-app\\src\\api\\productApi.js":"21","C:\\wamp\\www\\modaz-app\\src\\api\\orderApi.js":"22","C:\\wamp\\www\\modaz-app\\src\\modules\\ShowPrices.jsx":"23","C:\\wamp\\www\\modaz-app\\src\\api\\apiUtils.js":"24","C:\\wamp\\www\\modaz-app\\src\\api\\statisticsApi.js":"25","C:\\wamp\\www\\modaz-app\\src\\modules\\NewsList.js":"26","C:\\wamp\\www\\modaz-app\\src\\modules\\TodoList.js":"27","C:\\wamp\\www\\modaz-app\\src\\modules\\cart\\Cart.js":"28","C:\\wamp\\www\\modaz-app\\src\\api\\usersApi.js":"29","C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\OrderDetailsList.js":"30","C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\OrderDetailsQuote.js":"31","C:\\wamp\\www\\modaz-app\\src\\modules\\orders\\AddOrderItem.js":"32","C:\\wamp\\www\\modaz-app\\src\\functions.js":"33","C:\\wamp\